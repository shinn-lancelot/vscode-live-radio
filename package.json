{
  "name": "vscode-live-radio",
  "displayName": "Live Radio for VS Code",
  "description": "Listen to live Chinese radio streams without leaving VS Code.",
  "version": "0.1.0",
  "publisher": "shinn-lancelot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinn-lancelot/vscode-live-radio.git"
  },
  "keywords": [
    "radio",
    "internet radio",
    "audio streaming",
    "mp3",
    "hls",
    "m3u8"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./ && node scripts/copy-channels.js",
    "package": "pnpm run compile && pnpm exec vsce package --no-dependencies",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "activationEvents": [
    "onView:radio.player",
    "onCommand:radio.togglePlayback",
    "onCommand:radio.nextChannel",
    "onCommand:radio.previousChannel",
    "onCommand:radio.toggleFavorite",
    "onCommand:radio.togglePlaylist",
    "onCommand:radio.volumeUp",
    "onCommand:radio.volumeDown",
    "onCommand:radio.toggleMute"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "radio",
          "title": "Radio",
          "icon": "media/radio.svg"
        }
      ]
    },
    "views": {
      "radio": [
        {
          "type": "webview",
          "id": "radio.player",
          "name": "Radio"
        }
      ]
    },
    "commands": [
      {
        "command": "radio.togglePlayback",
        "title": "Radio: Play / Stop"
      },
      {
        "command": "radio.nextChannel",
        "title": "Radio: Next Channel"
      },
      {
        "command": "radio.previousChannel",
        "title": "Radio: Previous Channel"
      },
      {
        "command": "radio.toggleFavorite",
        "title": "Radio: Add / Remove Favorite"
      },
      {
        "command": "radio.togglePlaylist",
        "title": "Radio: Switch Playlist"
      },
      {
        "command": "radio.volumeUp",
        "title": "Radio: Volume Up"
      },
      {
        "command": "radio.volumeDown",
        "title": "Radio: Volume Down"
      },
      {
        "command": "radio.toggleMute",
        "title": "Radio: Mute / Unmute"
      }
    ],
    "keybindings": [
      {
        "command": "radio.togglePlayback",
        "key": "ctrl+shift+space"
      },
      {
        "command": "radio.previousChannel",
        "key": "ctrl+shift+,"
      },
      {
        "command": "radio.nextChannel",
        "key": "ctrl+shift+."
      },
      {
        "command": "radio.toggleFavorite",
        "key": "ctrl+shift+f"
      },
      {
        "command": "radio.togglePlaylist",
        "key": "ctrl+shift+;"
      },
      {
        "command": "radio.volumeUp",
        "key": "ctrl+shift+up"
      },
      {
        "command": "radio.volumeDown",
        "key": "ctrl+shift+down"
      },
      {
        "command": "radio.toggleMute",
        "key": "ctrl+shift+m"
      }
    ],
    "configuration": {
      "title": "Radio",
      "properties": {
        "radio.channels": {
          "type": "array",
          "description": "Custom radio channels appended to the built-in list. URL may be a direct MP3/OGG stream or an HLS M3U8 playlist.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Channel name",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "description": "Direct MP3/OGG or HLS M3U8 stream URL",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "description": "Optional short description"
              }
            }
          },
          "default": []
        },
        "radio.rememberLastChannel": {
          "type": "boolean",
          "description": "Remember the last selected channel.",
          "default": true
        }
      }
    }
  },
  "dependencies": {
    "hls.js": "^1.5.17"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.24.0",
    "typescript": "^5.3.3"
  }
}
